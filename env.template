# Well log OCR pipeline (OCR_main7.py) - configuration template.
# Copy this file to ".env" (same directory you run the script from, or next
# to the script) and fill in the values. Real environment variables always
# take precedence over .env values. NEVER commit the filled-in .env.

# --- required for the model stages (ocr / zoom / normalize) ---------------
# Your personal MindRouter API key. repair/validate/audit/score run offline
# and do not need it.
MINDROUTER_API_KEY=mr2_lteTmK5A8-EzwpkInvijEDXXenVpCJAHgGo8SRrN4Qc

# --- endpoints & models ---------------------------------------------------
# OpenAI-compatible chat endpoint host (default: University of Idaho
# MindRouter).
MINDROUTER_BASE_URL=https://mindrouter.uidaho.edu

# Vision model for transcription (stage 1 + zoom) and text model for
# JSON normalization (stage 2).
WELLLOG_OCR_MODEL=qwen/qwen3.6-27b
WELLLOG_NORMALIZE_MODEL=qwen/qwen3.6-35b

# --- data locations -------------------------------------------------------
# Directory of scanned well-report images (.jpg/.png/.tif).
WELLLOG_IMG_DIR=/mnt/ceph/sschmitz/wells_jpg/jpg_all

# SQLite output database. Use a NEW filename per experiment so runs stay
# comparable (the project history used well_logs_TV4/5/6...).
WELLLOG_DB=welllogs_main.sqlite

# Gold ground-truth file for the "score" mode (10 hand-audited pages).
WELLLOG_GOLD=gold_groundtruth.json

# --- behavior -------------------------------------------------------------
# OpenCV second witness for the lithology Water Y/N column:
#   override - CV wins Y<->N disagreements, blanks are flagged
#   flag     - CV disagreements are only noted in repair_notes
#   off      - skip the CV detector
# Defaults: v7 (test harness) = override; v8 (production) = flag.
# For a corpus run, start with flag, spot-check a sample, then re-run the
# offline "repair" stage with override.
WELLLOG_CV_POLICY=flag

# --- v8 (OCR_main8.py) production options ---------------------------------
# Parallel model requests.
WELLLOG_WORKERS=20

# Zoom proofread pass: on (best accuracy) or off (~2x faster per page).
WELLLOG_ZOOM=on

# HPC array-job sharding, e.g. "3/8" = this process handles the 3rd of 8
# hash-based slices and writes to WELLLOG_DB auto-suffixed .shard3of8.
# Leave empty for a single-process run. Combine shards with "merge".
WELLLOG_SHARD=

# Run log (everything printed is also appended here).
WELLLOG_LOG=well_logs_run.log

# Review-queue CSV written by the "export" mode.
WELLLOG_REVIEW_CSV=review_queue.csv
